# Local API: disabled unless a token is configured. Browser demo needs no secrets.
SHOWCASE_API_TOKEN=replace-with-a-long-random-token
SHOWCASE_TENANT_ID=north
PORT=4173

# Optional authenticated draft generator. Separate from the policy integration webhook.
# MAKE_AGENT_URL=https://your-authenticated-agent-gateway.example/draft
# MAKE_AGENT_TOKEN=replace-with-a-separate-long-random-token

# Optional explicit Make deployment (never loaded implicitly by the server)
# MAKE_API_KEY=replace-with-your-make-token
# MAKE_ZONE=eu1.make.com
# MAKE_TEAM_ID=replace-with-your-team-id

# Optional one-scenario live probe. No URL is hardcoded or used by default.
# MAKE_HOOK_01=https://your-explicit-webhook.example
# MAKE_PROBE_INPUT=/absolute/path/to/payload.json
# MAKE_PROBE_TOKEN=replace-if-required-by-your-webhook-gateway
