{
  "name": "list-clusters",
  "label": "List Available Guard Clusters",
  "description": "Remote procedure populating dynamic cluster zone dropdowns.",
  "communication": {
    "url": "/clusters",
    "method": "GET",
    "headers": {
      "Authorization": "Bearer {{connection.apiKey}}"
    },
    "response": {
      "output": {
        "value": "{{item.id}}",
        "label": "{{item.name}} ({{item.region}})"
      }
    }
  }
}
