{
  "name": "ping-health",
  "label": "Verify Connection Health",
  "description": "Validates the connection credentials upon saving in Make.",
  "communication": {
    "url": "/health/ping",
    "method": "GET",
    "headers": {
      "Authorization": "Bearer {{connection.apiKey}}"
    },
    "response": {
      "output": {
        "status": "{{body.status}}",
        "version": "{{body.version}}"
      }
    }
  }
}
