      "required": true,
      "options": [
        { "value": "eu-central-1", "label": "EU Central (Frankfurt)" },
        { "value": "eu-west-1", "label": "EU West (Ireland)" },
        { "value": "us-east-1", "label": "US East (N. Virginia)" }
      ]
    }
  ]
}
