{
  "name": "api-key",
  "label": "Enterprise Guard Secret Connection",
  "type": "key",
  "parameters": [
    {
      "name": "apiKey",
      "type": "text",
      "label": "Enterprise API Key",
      "required": true,
      "help": "Provide the guard cluster API secret for authentication."
    },
    {
      "name": "clusterZone",
      "type": "select",
