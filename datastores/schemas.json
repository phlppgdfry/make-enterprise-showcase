      { "name": "rawPayload", "type": "text", "label": "Raw Event Payload" },
      { "name": "failedAt", "type": "date", "label": "Failure Timestamp" }
    ]
  },
  {
    "name": "sync_cursor_store",
    "description": "High-watermark timestamp cursors and differential sync checkpoints.",
    "spec": [
      { "name": "key", "type": "text", "label": "Cursor Name", "required": true },
      { "name": "lastSyncedTimestamp", "type": "number", "label": "Unix Timestamp High-Watermark" },
      { "name": "recordsProcessed", "type": "number", "label": "Records Processed in Last Batch" },
      { "name": "lastSyncDate", "type": "date", "label": "Last Successful Run ISO" }
    ]
  },
  {
    "name": "rate_limiter_store",
    "description": "Sliding token-bucket request counters per 1-minute time window.",
