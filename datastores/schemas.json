      { "name": "confidence", "type": "number", "label": "Confidence Score" },
      { "name": "timestamp", "type": "date", "label": "Updated At" }
    ]
  },
  {
    "name": "idempotency_cache_store",
    "description": "Atomic deduplication locks and event TTL tracking for webhook pipelines.",
    "spec": [
      { "name": "key", "type": "text", "label": "Idempotency Key", "required": true },
      { "name": "status", "type": "text", "label": "Processing Status (PROCESSING|COMPLETED)", "required": true },
      { "name": "receivedAt", "type": "date", "label": "Received At" },
      { "name": "completedAt", "type": "date", "label": "Completed At" }
    ]
  },
  {
    "name": "dead_letter_queue_store",
    "description": "Dead Letter Queue (DLQ) capturing poison pills and fatal failure payloads for replay.",
    "spec": [
      { "name": "key", "type": "text", "label": "Event ID / Correlation Key", "required": true },
      { "name": "failedModule", "type": "text", "label": "Failed Module Identifier", "required": true },
