{
  "name": "01 - Autonomous Multi-Tool AI Agent & Human-in-the-Loop Orchestrator",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0, "name": "Incoming Omnichannel Webhook" }
      }
    },
    {
      "id": 2,
      "module": "openai-gpt-3:CreateCompletion",
      "version": 1,
      "parameters": {},
      "mapper": {
        "select": "chat",
        "model": "gpt-4o-mini",
        "messages": [
          {
            "role": "system",
            "content": "You are an Enterprise Autonomous Support Engineer. You resolve customer requests. Return JSON with resolution, confidenceScore, escalated, actionTaken."
          },
          {
            "role": "user",
            "content": "{{1.query}}"
          }
        ]
      },
      "metadata": {
        "designer": { "x": 300, "y": 0, "name": "OpenAI Reasoning Core" }
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": { "x": 600, "y": 0, "name": "Confidence & Risk Gateway" }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 4,
              "module": "slack:CreateMessage",
              "version": 4,
              "parameters": {},
              "mapper": {
                "channel": "C08ENTERPRISE",
                "text": "🚨 *Human-in-the-Loop Required*\n*Query:* {{1.query}}\n*Evaluation:* {{2.choices[1].message.content}}"
              },
              "filter": {
                "name": "Low Confidence or Escalated",
                "conditions": [
                  [
                    { "a": "{{2.choices[1].message.content}}", "o": "text:contains", "b": "escalated" }
                  ]
                ]
              },
              "metadata": {
                "designer": { "x": 900, "y": -150, "name": "Escalate to Slack Review" }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 5,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": 200,
                "headers": [
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "body": "{\"status\":\"success\",\"resolution\":\"{{2.choices[1].message.content}}\"}"
              },
              "metadata": {
                "designer": { "x": 900, "y": 150, "name": "Automated Webhook Response" }
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "version": 1
  }
}
