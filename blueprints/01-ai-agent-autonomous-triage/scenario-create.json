{
  "name": "01 - Evidence-Based Support Triage",
  "scheduling": {
    "type": "immediately"
  },
  "modules": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "label": "Authenticated inbound request",
      "config": {
        "parameters": {},
        "mapper": {}
      },
      "root": "main"
    },
    {
      "id": 2,
      "module": "json:CreateJSON",
      "version": 1,
      "label": "Serialize typed input",
      "config": {
        "parameters": {
          "type": "__REQUEST_DATA_STRUCTURE_ID__"
        },
        "mapper": {
          "query": "{{1.query}}",
          "customerId": "{{1.customerId}}",
          "action": "{{1.action}}",
          "amount": "{{1.amount}}"
        }
      },
      "follows": 1
    },
    {
      "id": 3,
      "module": "http:ActionSendRequest",
      "version": 1,
      "label": "Call tenant-bound policy gateway",
      "config": {
        "parameters": {},
        "mapper": {
          "url": "https://gateway.example.invalid/api/support",
          "method": "POST",
          "headers": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer __GATEWAY_TOKEN__"
            }
          ],
          "bodyType": "raw",
          "contentType": "application/json",
          "body": "{{2.json}}",
          "parseResponse": true
        }
      },
      "follows": 2
    },
    {
      "id": 4,
      "module": "gateway:WebhookRespond",
      "version": 1,
      "label": "Return structured decision",
      "config": {
        "parameters": {},
        "mapper": {
          "status": 200,
          "headers": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{{3.data}}"
        }
      },
      "follows": 3
    }
  ]
}
