{
  "name": "03 - Bi-Directional CRM & Billing Differential Sync Engine",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0, "name": "Batch Sync Webhook Trigger" }
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{1.customers}}"
      },
      "metadata": {
        "designer": { "x": 300, "y": 0, "name": "Iterator: Unroll Customer Batch" }
      }
    },
    {
      "id": 3,
      "module": "hubspotcrm:createContact",
      "version": 2,
      "parameters": {},
      "mapper": {
        "email": "{{2.email}}",
        "firstname": "{{2.name}}"
      },
      "metadata": {
        "designer": { "x": 600, "y": 0, "name": "HubSpot: Upsert Contact Record" }
      }
    },
    {
      "id": 4,
      "module": "builtin:BasicAggregator",
      "version": 1,
      "parameters": {
        "feeder": 2
      },
      "mapper": {
        "row": {
          "email": "{{2.email}}",
          "status": "UPSERTED"
        }
      },
      "metadata": {
        "designer": { "x": 900, "y": 0, "name": "Aggregate Batch Results" }
      }
    },
    {
      "id": 5,
      "module": "slack:CreateMessage",
      "version": 4,
      "parameters": {},
      "mapper": {
        "channel": "C08SYNC-AUDIT",
        "text": "📊 *Billing-to-CRM Sync Completed*\n*Records Synced:* {{length(4.array)}}\n*Status:* Healthy"
      },
      "metadata": {
        "designer": { "x": 1200, "y": 0, "name": "Post Audit Digest to Slack" }
      }
    },
    {
      "id": 6,
      "module": "gateway:WebhookRespond",
      "version": 1,
      "parameters": {},
      "mapper": {
        "status": 200,
        "headers": [
          { "name": "Content-Type", "value": "application/json" }
        ],
        "body": "{\"status\":\"synced\",\"count\":{{length(4.array)}}}"
      },
      "metadata": {
        "designer": { "x": 1500, "y": 0, "name": "Synchronous Batch Summary Response" }
      }
    }
  ],
  "metadata": {
    "version": 1
  }
}
