{
  "name": "04 - Self-Healing ETL Pipeline with Rate-Limit Governor & Transaction Rollback",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0, "name": "High-Volume ETL Ingestion Hook" }
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": { "x": 300, "y": 0, "name": "Rate-Limit Governor Router" }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 3,
              "module": "slack:CreateMessage",
              "version": 4,
              "parameters": {},
              "mapper": {
                "channel": "C08ETL-ALERTS",
                "text": "⚠️ *Rate Limit Governor Active*: Throttling incoming burst batch `{{1.batchId}}`."
              },
              "filter": {
                "name": "Rate Limit Exceeded Filter",
                "conditions": [
                  [
                    { "a": "{{1.requestCount}}", "o": "number:greater", "b": 250 }
                  ]
                ]
              },
              "metadata": {
                "designer": { "x": 600, "y": -150, "name": "Backpressure Alert" }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 4,
              "module": "builtin:BasicFeeder",
              "version": 1,
              "parameters": {},
              "mapper": {
                "array": "{{1.items}}"
              },
              "metadata": {
                "designer": { "x": 600, "y": 150, "name": "Iterate Batch Data Records" }
              }
            },
            {
              "id": 5,
              "module": "builtin:BasicAggregator",
              "version": 1,
              "parameters": {
                "feeder": 4
              },
              "mapper": {
                "row": {
                  "recordId": "{{4.id}}",
                  "status": "PROCESSED"
                }
              },
              "metadata": {
                "designer": { "x": 900, "y": 150, "name": "Collate Processed Records" }
              }
            },
            {
              "id": 6,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": 200,
                "headers": [
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "body": "{\"batchId\":\"{{1.batchId}}\",\"recordsIngested\":{{length(5.array)}},\"status\":\"success\"}"
              },
              "metadata": {
                "designer": { "x": 1200, "y": 150, "name": "Webhook ACK with Ingestion Telemetry" }
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "version": 1
  }
}
