{
  "name": "05 - Multi-Tenant Enterprise Knowledge RAG Engine",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0, "name": "Inbound Semantic Query Webhook" }
      }
    },
    {
      "id": 2,
      "module": "openai-gpt-3:CreateCompletion",
      "version": 1,
      "parameters": {},
      "mapper": {
        "select": "chat",
        "model": "gpt-4o-mini",
        "messages": [
          {
            "role": "system",
            "content": "You are an enterprise knowledge retrieval engine. Formulate a verified response with source citations based on query context. Format: JSON {answer: string, citations: string[], confidenceScore: number}"
          },
          {
            "role": "user",
            "content": "Tenant: {{1.tenantId}}\nQuery: {{1.query}}"
          }
        ]
      },
      "metadata": {
        "designer": { "x": 300, "y": 0, "name": "Synthesize Grounded Answer with Citations" }
      }
    },
    {
      "id": 3,
      "module": "gateway:WebhookRespond",
      "version": 1,
      "parameters": {},
      "mapper": {
        "status": 200,
        "headers": [
          { "name": "Content-Type", "value": "application/json" }
        ],
        "body": "{\"query\":\"{{1.query}}\",\"tenantId\":\"{{1.tenantId}}\",\"result\":\"{{2.choices[1].message.content}}\"}"
      },
      "metadata": {
        "designer": { "x": 600, "y": 0, "name": "Stream Grounded Answer with Citations" }
      }
    }
  ],
  "metadata": {
    "version": 1
  }
}
