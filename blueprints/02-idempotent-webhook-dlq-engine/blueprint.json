{
  "name": "02 - High-Throughput Idempotent Webhook Engine & Dead Letter Queue (DLQ)",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0, "name": "Signed Event Ingestion Gateway" }
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": { "x": 300, "y": 0, "name": "Idempotency Evaluation Router" }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 3,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": 200,
                "headers": [
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "body": "{\"status\":\"cached_ack\",\"message\":\"Event already processed\",\"idempotencyKey\":\"{{1.headers.`x-idempotency-key`}}\"}"
              },
              "filter": {
                "name": "Duplicate Key Filter",
                "conditions": [
                  [
                    { "a": "{{1.headers.`x-duplicate-flag`}}", "o": "boolean:equals", "b": true }
                  ]
                ]
              },
              "metadata": {
                "designer": { "x": 600, "y": -150, "name": "Duplicate Fast-Path ACK (200)" }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 4,
              "module": "stripe:CreateCharge",
              "version": 1,
              "parameters": {},
              "mapper": {
                "amount": "{{1.amount}}",
                "currency": "eur"
              },
              "metadata": {
                "designer": { "x": 600, "y": 150, "name": "Core Financial Mutation (Stripe)" }
              }
            },
            {
              "id": 5,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": 201,
                "headers": [
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "body": "{\"status\":\"processed\",\"idempotencyKey\":\"{{1.headers.`x-idempotency-key`}}\"}"
              },
              "metadata": {
                "designer": { "x": 900, "y": 150, "name": "Synchronous 201 Created Response" }
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "version": 1
  }
}
