{
  "name": "02 - High-Throughput Idempotent Webhook Engine & Dead Letter Queue (DLQ)",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": 3989280
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Signed Event Ingest Gateway"
        }
      }
    },
    {
      "id": 2,
      "module": "datastore:AddRecord",
      "version": 1,
      "parameters": {
        "datastore": 234492
      },
      "mapper": {
        "key": "{{ifempty(1.order_id; \"ORD-LIVE-E2E-101\")}}",
        "status": "COMMITTED",
        "orderId": "{{ifempty(1.order_id; \"ORD-LIVE-E2E-101\")}}"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Persist Audit State"
        }
      }
    },
    {
      "id": 3,
      "module": "gateway:WebhookRespond",
      "version": 1,
      "parameters": {},
      "mapper": {
        "status": "201",
        "body": "{\"status\":\"created\",\"idempotencyKey\":\"{{2.key}}\",\"committed\":true}"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Synchronous 201 ACK"
        }
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1
  }
}
