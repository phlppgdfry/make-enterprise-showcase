{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewable agent draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["draft", "citations", "escalated", "proposedAction"],
  "properties": {
    "draft": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "citations": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "description": "Cite each retrieved document ID at most once. Quotes must be exact substrings of retrieved text.", "items": { "type": "object", "required": ["id", "quote"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "quote": { "type": "string", "minLength": 12 } } } },
    "escalated": { "type": "boolean" },
    "proposedAction": { "type": "string", "enum": ["answer", "refund", "cancel", "upgrade"] }
  }
}
