{
  "name": "make-enterprise-showcase",
  "version": "2.2.0",
  "description": "Evidence-based Make automation reference with shared policy tools, authenticated API and an interactive workbench",
  "main": "scripts/validate-blueprints.js",
  "scripts": {
    "test": "node scripts/validate-blueprints.js && node --test tests/*.test.js",
    "test:lab": "node scripts/test-runner.js",
    "test:all": "npm test && npm run test:lab && npm run audit",
    "validate": "node scripts/validate-blueprints.js",
    "audit": "node scripts/audit-architecture.js",
    "probe": "node scripts/synthetic-test.js",
    "dispatch": "node scripts/dispatch-payload.js",
    "test:e2e": "node --test tests/workflows.test.js",
    "simulate": "node scripts/simulate.js",
    "setup-datastores": "node scripts/setup-datastores.js",
    "deploy": "./scripts/make-deploy.sh",
    "replay": "node scripts/dlq-replay.js",
    "export": "./scripts/make-export.sh",
    "start": "node scripts/server.js",
    "agent:plan": "node scripts/make-knowledge-agent.js",
    "agent:setup": "node scripts/make-knowledge-agent.js --apply",
    "agent:ask": "node scripts/make-knowledge-agent.js --ask",
    "agent:evaluate": "node scripts/evaluate-make-agent.js",
    "build:production": "node scripts/build-production.mjs",
    "start:production": "node scripts/production-preview.mjs",
    "test:production": "node --test tests/production.test.js",
    "db:generate": "drizzle-kit generate --config=production/drizzle.config.cjs",
    "format:check": "prettier --check production/src production/public production/db tests/production.test.js scripts/build-production.mjs scripts/production-preview.mjs scripts/production-smoke.mjs scripts/production-retention.mjs",
    "smoke:production": "node scripts/production-smoke.mjs"
  },
  "keywords": [
    "make",
    "makehq",
    "integromat",
    "automation",
    "mcp",
    "ai-agents",
    "blueprints",
    "enterprise-architecture",
    "workflow-automation"
  ],
  "author": "Philippe Godfroy",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "parse5": "8.1.1"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.2",
    "prettier": "3.9.10"
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
