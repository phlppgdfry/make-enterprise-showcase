{
  "name": "make-enterprise-showcase",
  "version": "2.1.0",
  "description": "Evidence-based Make automation reference with shared policy tools, authenticated API and an interactive workbench",
  "main": "scripts/validate-blueprints.js",
  "scripts": {
    "test": "node scripts/validate-blueprints.js && node --test tests/*.test.js",
    "test:lab": "node scripts/test-runner.js",
    "test:all": "npm test && npm run test:lab && npm run audit",
    "validate": "node scripts/validate-blueprints.js",
    "audit": "node scripts/audit-architecture.js",
    "probe": "node scripts/synthetic-test.js",
    "dispatch": "node scripts/dispatch-payload.js",
    "test:e2e": "node --test tests/workflows.test.js",
    "simulate": "node scripts/simulate.js",
    "setup-datastores": "node scripts/setup-datastores.js",
    "deploy": "./scripts/make-deploy.sh",
    "replay": "node scripts/dlq-replay.js",
    "export": "./scripts/make-export.sh",
    "start": "node scripts/server.js"
  },
  "keywords": [
    "make",
    "makehq",
    "integromat",
    "automation",
    "mcp",
    "ai-agents",
    "blueprints",
    "enterprise-architecture",
    "workflow-automation"
  ],
  "author": "Philippe Godfroy",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
